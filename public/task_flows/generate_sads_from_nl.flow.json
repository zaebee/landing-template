{
  "id": "mcp-generate-sads-from-nl-flow",
  "version": "1.0.0",
  "name": "MCP Task: Generate SADS from Natural Language",
  "description": "Handles an MCP task request to generate a Structured Architectural Description Schema (SADS) from a natural language input by calling an internal API.",
  "author": "Jules (AI Agent)",
  "creation_timestamp": "2024-07-15T10:00:00Z",
  "trigger": {
    "id": "trigger-mcp-sads-nl-request",
    "type": "MCPMessage",
    "description": "Triggers on MCP TASK_REQUEST for SADS generation from NL.",
    "filter_criteria": {
      "ontology_pattern": "elizaos:lpg:generate_sads_from_nl",
      "performative": "TASK_REQUEST"
    },
    "outputs": [
      {
        "source_path": "Message.Sender.AgentId",
        "data_element_id": "original_requester_agent_id",
        "description": "Captures the original sender's agent ID."
      },
      {
        "source_path": "Message.MessageId",
        "data_element_id": "original_mcp_message_id",
        "description": "Captures the original MCP message ID for replies."
      },
      {
        "source_path": "Message.TaskRequestPayload.TaskParameters",
        "data_element_id": "mcp_task_parameters_struct",
        "description": "The task_parameters field from the MCP message."
      }
    ]
  },
  "data_elements": [
    {
      "id": "original_requester_agent_id",
      "name": "Original Requester Agent ID",
      "data_type": "string",
      "description": "The agent ID of the MCP client that sent the request."
    },
    {
      "id": "original_mcp_message_id",
      "name": "Original MCP Message ID",
      "data_type": "string",
      "description": "The message ID of the incoming MCP request."
    },
    {
      "id": "mcp_task_parameters_struct",
      "name": "MCP Task Parameters",
      "data_type": "google.protobuf.Struct",
      "description": "Parameters provided in the task request, expected to contain the natural language input."
    },
    {
      "id": "natural_language_input_string",
      "name": "Natural Language Input",
      "data_type": "string",
      "description": "The extracted natural language text."
    },
    {
      "id": "api_request_json_string",
      "name": "API Request JSON",
      "data_type": "json_object_string",
      "description": "JSON payload for the internal /api/generate-sads-from-nl call.",
      "schema_definition": {
        "type": "object",
        "properties": {
          "natural_language_prompt": { "type": "string" }
        },
        "required": ["natural_language_prompt"]
      }
    },
    {
      "id": "internal_api_response_bytes",
      "name": "Internal API Response Body",
      "data_type": "bytes"
    },
    {
      "id": "internal_api_response_status_code",
      "name": "Internal API Response Status Code",
      "data_type": "integer"
    },
    {
      "id": "sads_output_struct",
      "name": "SADS Output Structure",
      "data_type": "google.protobuf.Struct",
      "description": "The SADS data generated by the API, formatted as a struct for MCP."
    },
    {
      "id": "error_details_struct",
      "name": "Error Details Structure",
      "data_type": "google.protobuf.Struct",
      "description": "Error information formatted as a struct for MCP Failure payload."
    },
    {
      "id": "mcp_service_agent_id",
      "name": "MCP Service Agent ID",
      "data_type": "string",
      "description": "The agent ID of this MCP service (e.g., 'jules')."
    }
  ],
  "stages": [
    {
      "id": "init-mcp-service-agent-id",
      "name": "Initialize Service Agent ID",
      "stage_type": "Transformation",
      "description": "Sets the MCP service's agent ID.",
      "outputs": [
        {
          "data_element_id": "mcp_service_agent_id",
          "produced_as": "value"
        }
      ],
      "transform_engine": "custom_code_snippet",
      "transform_logic": {
        "language": "static_value",
        "value": "jules"
      }
    },
    {
      "id": "extract-nl-from-params",
      "name": "Extract Natural Language Input",
      "stage_type": "Transformation",
      "description": "Extracts 'natural_language_input' field from the MCP task_parameters struct.",
      "dependencies": [],
      "inputs": [
        {
          "data_element_id": "mcp_task_parameters_struct",
          "as_name": "params_struct"
        }
      ],
      "outputs": [
        {
          "data_element_id": "natural_language_input_string",
          "produced_as": "nl_text"
        }
      ],
      "transform_engine": "custom_code_snippet",
      "transform_logic": {
        "language": "go_snippet",
        "code": "if val, ok := params_struct.Fields[\"natural_language_input\"]; ok { nl_text = val.GetStringValue() } else { /* ERROR */ }"
      },
      "on_error": [
        {
          "error_pattern": "*",
          "action": "ProceedToStage",
          "action_params": {
            "next_stage_id": "prepare-extraction-failure-response"
          }
        }
      ]
    },
    {
      "id": "construct-api-request",
      "name": "Construct API Request JSON",
      "stage_type": "Transformation",
      "description": "Creates the JSON payload for the /api/generate-sads-from-nl API.",
      "dependencies": ["extract-nl-from-params"],
      "inputs": [
        {
          "data_element_id": "natural_language_input_string",
          "as_name": "nl_input"
        }
      ],
      "outputs": [
        {
          "data_element_id": "api_request_json_string"
        }
      ],
      "transform_engine": "custom_code_snippet",
      "transform_logic": {
        "language": "go_snippet",
        "code": "/* request_map := map[string]interface{}{\"natural_language_prompt\": nl_input}; api_request_json_string = json.MarshalToString(request_map) */"
      },
      "on_error": [
        {
          "error_pattern": "*",
          "action": "ProceedToStage",
          "action_params": {
            "next_stage_id": "prepare-apirequest-build-failure-response"
          }
        }
      ]
    },
    {
      "id": "call-internal-sads-api",
      "name": "Call Internal SADS Generation API",
      "stage_type": "ActionCall",
      "description": "Makes an HTTP POST request to the internal /api/generate-sads-from-nl endpoint.",
      "dependencies": ["construct-api-request"],
      "inputs": [
        {
          "data_element_id": "api_request_json_string",
          "as_name": "request_body"
        }
      ],
      "outputs": [
        {
          "data_element_id": "internal_api_response_bytes",
          "produced_as": "response_body"
        },
        {
          "data_element_id": "internal_api_response_status_code",
          "produced_as": "status_code"
        }
      ],
      "action_type": "HttpApiCall",
      "action_details": {
        "method": "POST",
        "url_template": "http://localhost:{{flow_context.server_port}}/api/generate-sads-from-nl",
        "headers": {
          "Content-Type": "application/json"
        },
        "request_body_data_element_id": "api_request_json_string",
        "response_mappings": [
          {
            "source_path": "body",
            "data_element_id": "internal_api_response_bytes"
          },
          {
            "source_path": "statusCode",
            "data_element_id": "internal_api_response_status_code"
          }
        ]
      },
      "on_error": [
        {
          "error_pattern": "*",
          "action": "ProceedToStage",
          "action_params": {
            "next_stage_id": "prepare-apicall-failure-response"
          }
        }
      ]
    },
    {
      "id": "check-api-response-status",
      "name": "Check API Response Status",
      "stage_type": "DecisionPoint",
      "description": "Routes flow based on the API response status code.",
      "dependencies": ["call-internal-sads-api"],
      "inputs": [
        {
          "data_element_id": "internal_api_response_status_code",
          "as_name": "status"
        }
      ],
      "decision_logic_engine": "cel_expression",
      "branches": [
        {
          "condition": "status >= 200 && status < 300",
          "next_stage_id": "transform-api-response-to-mcp-result",
          "description": "API call was successful."
        }
      ],
      "default_branch_next_stage_id": "prepare-apicall-failure-response"
    },
    {
      "id": "transform-api-response-to-mcp-result",
      "name": "Transform API Response to MCP ResultDetails",
      "stage_type": "Transformation",
      "description": "Converts the API's JSON response into a structpb.Struct for MCP InformResult.ResultDetails.",
      "dependencies": ["check-api-response-status"],
      "inputs": [
        {
          "data_element_id": "internal_api_response_bytes",
          "as_name": "api_response_body"
        }
      ],
      "outputs": [
        {
          "data_element_id": "sads_output_struct"
        }
      ],
      "transform_engine": "custom_code_snippet",
      "transform_logic": {
        "language": "go_snippet",
        "code": "/* var data_map map[string]interface{}; json.Unmarshal(api_response_body, &data_map); sads_output_struct, err = structpb.NewStruct(data_map) */"
      },
      "on_error": [
        {
          "error_pattern": "*",
          "action": "ProceedToStage",
          "action_params": {
            "next_stage_id": "prepare-resulttransform-failure-response"
          }
        }
      ]
    },
    {
      "id": "prepare-inform-result",
      "name": "Prepare MCP InformResult",
      "stage_type": "ActionCall",
      "description": "Constructs the successful MCP InformResult message.",
      "dependencies": ["transform-api-response-to-mcp-result", "init-mcp-service-agent-id"],
      "inputs": [
        { "data_element_id": "original_requester_agent_id", "as_name": "receiver_id" },
        { "data_element_id": "original_mcp_message_id", "as_name": "reply_to_id" },
        { "data_element_id": "sads_output_struct", "as_name": "result_payload_details" },
        { "data_element_id": "mcp_service_agent_id", "as_name": "sender_id" }
      ],
      "outputs": [
        { "data_element_id": "outgoing_mcp_message_object", "produced_as": "mcp_message" }
      ],
      "action_type": "InternalFunctionCall",
      "action_details": {
        "function_name": "mcpHelper.CreateInformResult",
        "parameter_mappings": [
          { "arg_name": "senderAgentId", "source_data_element_id": "mcp_service_agent_id" },
          { "arg_name": "receiverAgentId", "source_data_element_id": "original_requester_agent_id" },
          { "arg_name": "inReplyToMessageId", "source_data_element_id": "original_mcp_message_id" },
          { "arg_name": "resultDetails", "source_data_element_id": "sads_output_struct" },
          { "arg_name": "summary", "static_value": "SADS generation successful." }
        ]
      },
      "on_error": [
        {
          "error_pattern": "*",
          "action": "ProceedToStage",
          "action_params": { "next_stage_id": "prepare-generic-failure-response" }
        }
      ]
    },
    {
      "id": "prepare-extraction-failure-response",
      "name": "Prepare Extraction Failure Details",
      "stage_type": "Transformation",
      "description": "Creates error details for 'natural_language_input' extraction failure.",
      "outputs": [{ "data_element_id": "error_details_struct" }],
      "transform_engine": "static_value",
      "transform_logic": {
        "language": "static_map_to_struct",
        "value": {
          "error_code": "EXTRACT_NL_FAILED",
          "error_message": "Could not extract 'natural_language_input' from task parameters."
        }
      }
    },
    {
      "id": "prepare-apicall-failure-response",
      "name": "Prepare API Call Failure Details",
      "stage_type": "Transformation",
      "description": "Creates error details for internal API call failure.",
      "dependencies": ["call-internal-sads-api"],
      "inputs": [
        { "data_element_id": "internal_api_response_status_code", "as_name": "status_code", "is_required": false },
        { "data_element_id": "internal_api_response_bytes", "as_name": "response_body", "is_required": false }
      ],
      "outputs": [{ "data_element_id": "error_details_struct" }],
      "transform_engine": "custom_code_snippet",
      "transform_logic": {
        "language": "go_snippet",
        "code": "/* Based on status_code and response_body, create a meaningful error struct. */"
      }
    },
    {
      "id": "prepare-mcp-failure-message",
      "name": "Prepare MCP Failure Message",
      "stage_type": "ActionCall",
      "description": "Constructs the MCP Failure message.",
      "dependencies": ["prepare-extraction-failure-response"],
      "inputs": [
        { "data_element_id": "error_details_struct", "as_name": "failure_payload_details" },
        { "data_element_id": "mcp_service_agent_id", "as_name": "sender_id" }
      ],
      "outputs": [
        { "data_element_id": "outgoing_mcp_message_object", "produced_as": "mcp_message" }
      ],
      "action_type": "InternalFunctionCall",
      "action_details": {
        "function_name": "mcpHelper.CreateFailureMessage"
      }
    },
    {
      "id": "send-mcp-response",
      "name": "Send MCP Response",
      "stage_type": "ActionCall",
      "description": "Sends the constructed MCP message back to the original requester.",
      "dependencies": ["prepare-inform-result", "prepare-mcp-failure-message"],
      "inputs": [
        { "data_element_id": "outgoing_mcp_message_object", "as_name": "message_to_send" },
        { "data_element_id": "original_requester_agent_id", "as_name": "target_agent_id" }
      ],
      "action_type": "McpMessageSend",
      "action_details": {
        "target_agent_id_data_element": "original_requester_agent_id",
        "mcp_message_data_element": "outgoing_mcp_message_object"
      }
    }
  ]
}
