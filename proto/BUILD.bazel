load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library") # proto_library should be globally available

# Define a proto_library for each .proto file
proto_library(
    name = "blog_post_proto",
    srcs = ["blog_post.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "common_proto",
    srcs = ["common.proto"],
)

proto_library(
    name = "contact_form_config_proto",
    srcs = ["contact_form_config.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "feature_item_proto",
    srcs = ["feature_item.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "hero_item_proto",
    srcs = ["hero_item.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "nav_item_proto",
    srcs = ["nav_item.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "portfolio_item_proto",
    srcs = ["portfolio_item.proto"],
    deps = [":common_proto"],
)

proto_library(
    name = "sads_styling_v1_proto",
    srcs = ["sads_styling.v1.proto"],
)

proto_library(
    name = "testimonial_item_proto",
    srcs = ["testimonial_item.proto"],
    deps = [":common_proto"],
)

# Aggregate all protos for convenience if needed, though direct dependencies are preferred.
proto_library(
    name = "all_protos",
    deps = [
        ":blog_post_proto",
        ":common_proto",
        ":contact_form_config_proto",
        ":feature_item_proto",
        ":hero_item_proto",
        ":nav_item_proto",
        ":portfolio_item_proto",
        ":sads_styling_v1_proto",
        ":testimonial_item_proto",
    ],
)

# Go proto generation
go_proto_library(
    name = "all_protos_go",
    proto = ":all_protos",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "app/generated/go",
    visibility = ["//visibility:public"],
)

