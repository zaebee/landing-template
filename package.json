{
  "name": "landing-template",
  "version": "1.0.0",
  "description": "Template web site with landing page. Go backend built with Bazel.",
  "scripts": {
    "build:go": "npx bazel build //:landing_page_generator_binary",
    "start:go": "npx bazel run //:landing_page_generator_binary",
    "build": "npm run build:go",
    "start": "npm run start:go",
    // "compile:ts": "tsc -p tsconfig.json", // TS compilation deferred
    "run": "python -m http.server",
    "test": "echo \"No Go tests implemented yet\"",
    "lint:py": "ruff check . && mypy .",
    "lint:py:fix": "ruff check . --fix && mypy .",
    "format": "prettier --write \"**/*.{json,css,html,js,jsx,ts,tsx,md,mdx}\" && clang-format -i proto/*.proto",
    "lint": "npm run lint:py && npm run format && ruff format"
    // "generate-proto:go": "...", // Handled by Bazel
    // "generate-proto:ts": "...", // Handled by Bazel (TS part currently commented out in proto/BUILD.bazel)
    // "generate-proto": "...",    // Handled by Bazel
    // "generate-proto-win": "..." // Handled by Bazel
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@protobuf-ts/runtime": "^2.9.4",
    "google-protobuf": "^3.21.4"
  },
  "devDependencies": {
    "@bazel/bazelisk": "^1.26.0",
    "@protobuf-ts/plugin": "^2.9.4",
    "clang-format": "^1.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.3"
  }
}
