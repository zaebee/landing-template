# --- API Keys (Required if using the respective provider) ---
# For OpenAI:
# OPENAI_API_KEY="your_openai_api_key_here"

# For Mistral AI:
MISTRAL_API_KEY="your_mistral_api_key_here" # Or replace with your actual key

# --- Optional LLM Configuration ---
# Default model names (if --model CLI argument is not provided)
# These are examples; uncomment and set to your preferred defaults.
# DEFAULT_OPENAI_MODEL="gpt-3.5-turbo"
# DEFAULT_MISTRAL_MODEL="mistral-small-latest" # Or e.g., "mistral-tiny", "mistral-medium-latest"

# Default LLM parameters (can be overridden by CLI arguments --temperature and --max_tokens)
# These are examples; uncomment and set to your preferred defaults.
# DEFAULT_LLM_TEMPERATURE="0.2"
# DEFAULT_LLM_MAX_TOKENS="200"
